{
  "compilerOptions": {
    "target": "ES2019",
    "lib": [
      "DOM",
      "ES2019"
    ],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "sourceMap": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./global.d.ts"
  ]
}
